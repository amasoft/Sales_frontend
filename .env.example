# Base URL of the POS backend API (see docs/pos-inventory-sales-tracking-prd.html
# for the expected endpoint contract). Trailing slash is stripped automatically.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Defaults used to seed the Settings > Business Profile screen the first time
# the app runs. All of these are editable afterwards from within the app.
VITE_BUSINESS_NAME="Chingi Gadgets Store"
VITE_BUSINESS_ADDRESS="No 12, Medical Road, Computer Village, Ikeja"
VITE_BUSINESS_PHONE="234-8130523194"
